PROGRAM C: INDEXED FILE ORGANIZATION
---------------------------------------------------------------------------------------------------------------
#include <stdio.h>

struct student
{
    int regno;
    char name[20];
};

int main()
{
    struct student s[3];
    int key, i;

    printf("Enter 3 Student Records\n");

    for (i = 0; i < 3; i++)
    {
        printf("Enter Register Number and Name: ");
        scanf("%d %19s", &s[i].regno, s[i].name);
    }

    printf("Enter Register Number to Search: ");
    scanf("%d", &key);

    for (i = 0; i < 3; i++)
    {
        if (s[i].regno == key)
        {
            printf("\nRecord Found\n");
            printf("Reg No : %d\n", s[i].regno);
            printf("Name : %s\n", s[i].name);

            return 0;
        }
    }

    printf("Record Not Found\n");

    return 0;
}

OUTPUT:
Enter 3 Student Records
Enter Register Number and Name: 101 Arun
Enter Register Number and Name: 102 Kumar
Enter Register Number and Name: 103 Ravi

Enter Register Number to Search: 102

Record Found
Reg No : 102
Name : Kumar
