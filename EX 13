PROGRAM B: DIRECT (RANDOM) FILE ORGANIZATION
------------------------------------------------------------------------------------------------------------------
#include <stdio.h>

struct student
{
    int regno;
    char name[20];
};

int main()
{
    FILE *fp;
    struct student s;

    fp = fopen("random.dat", "wb+");

    if (fp == NULL)
    {
        printf("File cannot be opened.\n");
        return 1;
    }

    printf("Enter Register Number: ");
    scanf("%d", &s.regno);

    printf("Enter Name: ");
    scanf("%19s", s.name);

    fwrite(&s, sizeof(s), 1, fp);

    rewind(fp);

    fread(&s, sizeof(s), 1, fp);

    printf("\nRecord Found\n");
    printf("Reg No : %d\n", s.regno);
    printf("Name : %s\n", s.name);

    fclose(fp);

    return 0;
}
OUTPUT:
Enter Register Number: 102
Enter Name: Kumar

Record Found
Reg No : 102
Name : Kumar
