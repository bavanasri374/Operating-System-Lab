PROGRAM A: SEQUENTIAL FILE ALLOCATION
--------------------------------------------------------------------------------------------------------
#include <stdio.h>

int main()
{
    int start, length, i;

    printf("Enter Starting Block: ");
    scanf("%d", &start);

    printf("Enter File Length (Number of Blocks): ");
    scanf("%d", &length);

    printf("\nAllocated Blocks:\n");

    for (i = 0; i < length; i++)
    {
        printf("%d ", start + i);
    }


    printf("\n");

    return 0;
}

OUTPUT:
Enter Starting Block: 10
Enter File Length (Number of Blocks): 5

Allocated Blocks:
10 11 12 13 14
