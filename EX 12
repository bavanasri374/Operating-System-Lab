PROGRAM B: LRU PAGE REPLACEMENT
-----------------------------------------------------------------------------------------------------------------------
#include <stdio.h>

int main()
{
    int pages[50], frames[10], time[10];
    int n, f, i, j;
    int fault = 0, count = 0;
    int found, pos, min;

    printf("Enter Number of Pages: ");
    scanf("%d", &n);

    printf("Enter Reference String:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter Number of Frames: ");
    scanf("%d", &f);

    /* Initialize frames */
    for (i = 0; i < f; i++)
    {
        frames[i] = -1;
        time[i] = 0;
    }

    /* LRU Page Replacement */
    for (i = 0; i < n; i++)
    {
        found = 0;

        /* Check if page is already present */
        for (j = 0; j < f; j++)
        {
            if (frames[j] == pages[i])
            {
                count++;
                time[j] = count;
                found = 1;
                break;
            }
        }

        /* Page Fault */
        if (found == 0)
        {
            min = time[0];
            pos = 0;

            for (j = 0; j < f; j++)
            {
                /* Find an empty frame first */
                if (frames[j] == -1)
                {
                    pos = j;
                    break;
                }

                /* Find least recently used page */
                if (time[j] < min)
                {
                    min = time[j];
                    pos = j;
                }
            }

            frames[pos] = pages[i];

            count++;
            time[pos] = count;

            fault++;
        }
    }

    printf("Total Page Faults = %d\n", fault);

    return 0;
}

OUTPUT:
Enter Number of Pages: 12
Enter Reference String:
1 2 3 4 1 2 5 1 2 3 4 5
Enter Number of Frames: 3

Total Page Faults = 10
