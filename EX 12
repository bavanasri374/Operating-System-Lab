PROGRAM C: OPTIMAL PAGE REPLACEMENT
------------------------------------------------------------------------------------------------------------------------
#include <stdio.h>

int main()
{
    int pages[50], frames[10];
    int n, f;
    int i, j, k, pos;
    int fault = 0;
    int found;

    printf("Enter Number of Pages: ");
    scanf("%d", &n);

    printf("Enter Reference String:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter Number of Frames: ");
    scanf("%d", &f);

    /* Initialize frames */
    for (i = 0; i < f; i++)
        frames[i] = -1;

    /* Optimal Page Replacement */
    for (i = 0; i < n; i++)
    {
        found = 0;

        /* Check whether page is already present */
        for (j = 0; j < f; j++)
        {
            if (frames[j] == pages[i])
            {
                found = 1;
                break;
            }
        }

        /* Page Fault */
        if (found == 0)
        {
            pos = -1;

            /* Check for empty frame */
            for (j = 0; j < f; j++)
            {
                if (frames[j] == -1)
                {
                    pos = j;
                    break;
                }
            }

            /* If no empty frame, find page used farthest in future */
            if (pos == -1)
            {
                int farthest = -1;

                for (j = 0; j < f; j++)
                {
                    int future = n;

                    for (k = i + 1; k < n; k++)
                    {
                        if (frames[j] == pages[k])
                        {
                            future = k;
                            break;
                        }
                    }

                    if (future > farthest)
                    {
                        farthest = future;
                        pos = j;
                    }
                }
            }

            frames[pos] = pages[i];
            fault++;
        }
    }

    printf("Total Page Faults = %d\n", fault);

    return 0;
}
